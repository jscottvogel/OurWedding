# Copy to .env.local for local development. Never commit real secrets.
# In Amplify Hosting, set these under App settings -> Environment variables.

# --- Public (inlined into the client bundle at build time) ---
# Canonical base URL, used for sitemap.xml, robots.txt and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Apex domain that wedding subdomains hang off (<slug>.<root>). Used by middleware and emails.
NEXT_PUBLIC_ROOT_DOMAIN=weddingsteward.com
# Shows the "Try the demo" button. Must match DEMO_ENABLED.
NEXT_PUBLIC_DEMO_ENABLED=false

# --- Server only ---
# AWS region for server-side SDK clients (SES). Amplify Hosting sets this automatically.
AWS_REGION=us-east-1
# Shared secret the Next.js server sends to the public-site Lambda (via AppSync).
# Must equal the Amplify secret INTERNAL_API_SECRET. Generate: openssl rand -hex 32
INTERNAL_API_SECRET=change-me
# HMAC key for the HttpOnly cookie issued after a wedding-site password is verified.
# Generate: openssl rand -hex 32
SITE_COOKIE_SECRET=change-me
# Verified SES sender for RSVP confirmations (defaults to hello@<NEXT_PUBLIC_ROOT_DOMAIN>).
SES_FROM_ADDRESS=hello@weddingsteward.com

# Demo account (server-side login via /api/demo/login). Leave disabled in production
# unless you intend to expose the demo.
DEMO_ENABLED=false
DEMO_USER_EMAIL=demo@weddingsteward.com
DEMO_USER_PASSWORD=change-me
